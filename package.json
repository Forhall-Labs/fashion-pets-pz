    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "^3.0.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "cspell": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",

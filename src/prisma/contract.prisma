// Data contract for the pet grooming shop agenda system.
// Source of truth: docs/system_design.md §3. Single Admin actor (Supabase
// Auth) — RLS is "authenticated can do everything, anon can do nothing",
// not per-row ownership (there's no multi-tenant concept here).

enum PetSize {
  @@type("pg/text@1")
  small       = "small"
  medium      = "medium"
  extra_large = "extra_large"
}

enum GroomingFrequency {
  @@type("pg/text@1")
  twice_a_month         = "twice_a_month"
  once_a_month          = "once_a_month"
  once_every_two_months = "once_every_two_months"
}

enum ServiceType {
  @@type("pg/text@1")
  full_groom    = "full_groom"
  quick_service = "quick_service"
}

enum AppointmentStatus {
  @@type("pg/text@1")
  scheduled = "scheduled"
  completed = "completed"
  cancelled = "cancelled"
}

enum AppointmentSource {
  @@type("pg/text@1")
  manual                = "manual"
  auto_scheduled         = "auto_scheduled"
  waiting_list_approval  = "waiting_list_approval"
}

enum WaitingListStatus {
  @@type("pg/text@1")
  active    = "active"
  fulfilled = "fulfilled"
  cancelled = "cancelled"
}

enum Weekday {
  @@type("pg/text@1")
  monday    = "monday"
  tuesday   = "tuesday"
  wednesday = "wednesday"
  thursday  = "thursday"
  friday    = "friday"
  saturday  = "saturday"
  sunday    = "sunday"
}

namespace public {
  model Owner {
    id            Uuid     @id @default(uuid())
    name          String
    phone         String
    address       String?
    addressLat    Decimal? @map("address_lat")
    addressLng    Decimal? @map("address_lng")
    fixedVisitDay Weekday? @map("fixed_visit_day")
    pets          Pet[]
    createdAt     TimestamptzString @default(now()) @map("created_at")
    updatedAt     temporal.updatedAtString() @map("updated_at")

    @@map("owners")
    @@rls
  }

  // Single-Admin app: any authenticated request may do anything: there is no
  // per-row ownership to filter by (see docs/system_design.md §2.5).
  policy_all owners_admin_only {
    target    = Owner
    roles     = [authenticated]
    using     = "true"
    withCheck = "true"
  }

  model Pet {
    id                        Uuid               @id @default(uuid())
    ownerId                   Uuid               @map("owner_id")
    owner                     Owner              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
    name                      String
    breed                     String?
    size                      PetSize
    isAggressive              Boolean            @default(false) @map("is_aggressive")
    groomingFrequency         GroomingFrequency? @map("grooming_frequency")
    needsPickup               Boolean            @default(false) @map("needs_pickup")
    locationAddress           String?            @map("location_address")
    locationLat               Decimal?           @map("location_lat")
    locationLng               Decimal?           @map("location_lng")
    avgServiceDurationMinutes Int?               @map("avg_service_duration_minutes")
    appointments              Appointment[]
    waitingListEntries        WaitingListEntry[]
    createdAt                 TimestamptzString  @default(now()) @map("created_at")
    updatedAt                 temporal.updatedAtString() @map("updated_at")

    @@index([ownerId])
    @@map("pets")
    @@rls
  }

  policy_all pets_admin_only {
    target    = Pet
    roles     = [authenticated]
    using     = "true"
    withCheck = "true"
  }

  model Appointment {
    id              Uuid              @id @default(uuid())
    petId           Uuid              @map("pet_id")
    pet             Pet               @relation(fields: [petId], references: [id], onDelete: Restrict)
    date            DateString
    startTime       TimeString        @map("start_time")
    durationMinutes Int               @map("duration_minutes")
    serviceType     ServiceType       @map("service_type")
    status          AppointmentStatus @default(scheduled)
    source          AppointmentSource
    flaggedReason   String?           @map("flagged_reason")
    createdAt       TimestamptzString @default(now()) @map("created_at")
    updatedAt       temporal.updatedAtString() @map("updated_at")

    @@index([petId])
    @@index([date])
    @@map("appointments")
    @@rls
  }

  policy_all appointments_admin_only {
    target    = Appointment
    roles     = [authenticated]
    using     = "true"
    withCheck = "true"
  }

  model WaitingListEntry {
    id                     Uuid              @id @default(uuid())
    petId                  Uuid              @map("pet_id")
    pet                    Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
    preferredStartDate     DateString?       @map("preferred_start_date")
    preferredEndDate       DateString?       @map("preferred_end_date")
    status                 WaitingListStatus @default(active)
    fulfilledAppointmentId Uuid?             @unique @map("fulfilled_appointment_id")
    fulfilledAppointment   Appointment?      @relation(fields: [fulfilledAppointmentId], references: [id], onDelete: SetNull)
    createdAt              TimestamptzString @default(now()) @map("created_at")
    updatedAt              temporal.updatedAtString() @map("updated_at")

    @@index([petId])
    @@index([status])
    @@map("waiting_list_entries")
    @@rls
  }

  policy_all waiting_list_entries_admin_only {
    target    = WaitingListEntry
    roles     = [authenticated]
    using     = "true"
    withCheck = "true"
  }

  // Single-row table (app enforces exactly one row — docs/system_design.md §3.2).
  model ShopConfig {
    id                          Uuid       @id @default(uuid())
    maxPetsPerDay               Int        @map("max_pets_per_day")
    quickServiceDurationMinutes Int?       @map("quick_service_duration_minutes")
    openTime                    TimeString @map("open_time")
    closeTime                   TimeString @map("close_time")
    updatedAt                   temporal.updatedAtString() @map("updated_at")

    @@check(expression: "max_pets_per_day > 0", name: "shop_config_max_pets_per_day_positive")
    @@check(expression: "close_time > open_time", name: "shop_config_close_after_open")
    @@map("shop_config")
    @@rls
  }

  policy_all shop_config_admin_only {
    target    = ShopConfig
    roles     = [authenticated]
    using     = "true"
    withCheck = "true"
  }

  model BlackoutPeriod {
    id        Uuid              @id @default(uuid())
    startDate DateString        @map("start_date")
    endDate   DateString        @map("end_date")
    label     String?
    createdAt TimestamptzString @default(now()) @map("created_at")

    @@check(expression: "end_date >= start_date", name: "blackout_periods_end_after_start")
    @@index([startDate, endDate])
    @@map("blackout_periods")
    @@rls
  }

  policy_all blackout_periods_admin_only {
    target    = BlackoutPeriod
    roles     = [authenticated]
    using     = "true"
    withCheck = "true"
  }
}
